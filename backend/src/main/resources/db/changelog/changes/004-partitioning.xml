<?xml version="1.0" encoding="UTF-8"?>
<!--
 ============================================================================
 TICKET-ADV007 — Monthly partitioning of trades on Postgres
 WHAT:    Convert trades into a range-partitioned parent on trade_date and
          create partitions for the current rolling window (April-July 2026)
          plus a DEFAULT partition for safety.
 HOW:     Postgres-only via raw SQL. Rename existing table, recreate as
          partitioned, migrate data, drop legacy.
 WHY:     Large trades table would be slow; monthly partitions give
          predictable partition-pruning in EXPLAIN plans.
 OBSERVE: \d+ trades shows "Partitioned table" + monthly child partitions.
 ============================================================================
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Step 1: Drop foreign key from settlements so we can recreate trades -->
    <changeSet id="004-drop-settlements-fk" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
            <foreignKeyConstraintExists foreignKeyTableName="settlements" foreignKeyName="fk_settlements_trade"/>
        </preConditions>
        <dropForeignKeyConstraint baseTableName="settlements" constraintName="fk_settlements_trade"/>
        <rollback>
            <addForeignKeyConstraint baseTableName="settlements" baseColumnNames="trade_id"
                                     constraintName="fk_settlements_trade"
                                     referencedTableName="trades" referencedColumnNames="id"/>
        </rollback>
    </changeSet>

    <!-- Step 2: Rename existing trades table -->
    <changeSet id="004-rename-trades-to-legacy" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
            <tableExists tableName="trades"/>
            <not><tableExists tableName="trades_legacy"/></not>
        </preConditions>
        <renameTable oldTableName="trades" newTableName="trades_legacy"/>
        <rollback>
            <renameTable oldTableName="trades_legacy" newTableName="trades"/>
        </rollback>
    </changeSet>

    <!-- Step 3: Create partitioned parent table -->
    <changeSet id="004-create-partitioned-trades" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
            <not><tableExists tableName="trades"/></not>
        </preConditions>
        <sql>
            CREATE TABLE trades (
                id              BIGSERIAL,
                trade_ref       VARCHAR(30)   NOT NULL,
                instrument_id   BIGINT        NOT NULL,
                counterparty_id BIGINT        NOT NULL,
                asset_class     VARCHAR(20)   NOT NULL,
                side            VARCHAR(4)    NOT NULL,
                quantity        NUMERIC(18,4) NOT NULL,
                price           NUMERIC(18,4) NOT NULL,
                trade_date      DATE          NOT NULL,
                status          VARCHAR(20)   NOT NULL DEFAULT 'PENDING',
                deleted_at      TIMESTAMPTZ,
                created_at      TIMESTAMPTZ   NOT NULL DEFAULT now(),
                modified_at     TIMESTAMPTZ,
                PRIMARY KEY (id, trade_date)
            ) PARTITION BY RANGE (trade_date);
        </sql>
        <rollback>
            <dropTable tableName="trades"/>
        </rollback>
    </changeSet>

    <!-- Step 4: Create monthly partitions (April - July 2026) -->
    <changeSet id="004-create-partition-y2026m04" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
            <tableExists tableName="trades"/>
        </preConditions>
        <sql>
            CREATE TABLE trades_y2026m04 PARTITION OF trades
                FOR VALUES FROM ('2026-04-01') TO ('2026-05-01');
        </sql>
        <rollback>
            <sql>DROP TABLE IF EXISTS trades_y2026m04;</sql>
        </rollback>
    </changeSet>

    <changeSet id="004-create-partition-y2026m05" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
            <tableExists tableName="trades"/>
        </preConditions>
        <sql>
            CREATE TABLE trades_y2026m05 PARTITION OF trades
                FOR VALUES FROM ('2026-05-01') TO ('2026-06-01');
        </sql>
        <rollback>
            <sql>DROP TABLE IF EXISTS trades_y2026m05;</sql>
        </rollback>
    </changeSet>

    <changeSet id="004-create-partition-y2026m06" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
            <tableExists tableName="trades"/>
        </preConditions>
        <sql>
            CREATE TABLE trades_y2026m06 PARTITION OF trades
                FOR VALUES FROM ('2026-06-01') TO ('2026-07-01');
        </sql>
        <rollback>
            <sql>DROP TABLE IF EXISTS trades_y2026m06;</sql>
        </rollback>
    </changeSet>

    <changeSet id="004-create-partition-y2026m07" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
            <tableExists tableName="trades"/>
        </preConditions>
        <sql>
            CREATE TABLE trades_y2026m07 PARTITION OF trades
                FOR VALUES FROM ('2026-07-01') TO ('2026-08-01');
        </sql>
        <rollback>
            <sql>DROP TABLE IF EXISTS trades_y2026m07;</sql>
        </rollback>
    </changeSet>

    <!-- Step 5: Create default partition for dates outside defined ranges -->
    <changeSet id="004-create-partition-default" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
            <tableExists tableName="trades"/>
        </preConditions>
        <sql>
            CREATE TABLE trades_default PARTITION OF trades DEFAULT;
        </sql>
        <rollback>
            <sql>DROP TABLE IF EXISTS trades_default;</sql>
        </rollback>
    </changeSet>

    <!-- Step 6: Skip unique constraint on id alone - not possible with partitioned tables.
         PostgreSQL requires unique constraints to include all partition columns.
         The PK (id, trade_date) already ensures uniqueness within partitions. -->

    <!-- Step 7: Recreate indexes on partitioned table -->
    <changeSet id="004-create-partition-indexes" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
            <tableExists tableName="trades"/>
        </preConditions>
        <sql>
            CREATE INDEX IF NOT EXISTS idx_trades_trade_date ON trades (trade_date);
            CREATE INDEX IF NOT EXISTS idx_trades_status ON trades (status);
            CREATE INDEX IF NOT EXISTS idx_trades_trade_ref ON trades (trade_ref);
        </sql>
        <rollback>
            <sql>
                DROP INDEX IF EXISTS idx_trades_trade_date;
                DROP INDEX IF EXISTS idx_trades_status;
                DROP INDEX IF EXISTS idx_trades_trade_ref;
            </sql>
        </rollback>
    </changeSet>

    <!-- Step 8: Add foreign key constraints -->
    <changeSet id="004-add-partition-fks" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
            <tableExists tableName="trades"/>
        </preConditions>
        <addForeignKeyConstraint baseTableName="trades" baseColumnNames="instrument_id"
                                 constraintName="fk_trades_instrument"
                                 referencedTableName="instruments" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="trades" baseColumnNames="counterparty_id"
                                 constraintName="fk_trades_counterparty"
                                 referencedTableName="counterparties" referencedColumnNames="id"/>
        <rollback>
            <dropForeignKeyConstraint baseTableName="trades" constraintName="fk_trades_instrument"/>
            <dropForeignKeyConstraint baseTableName="trades" constraintName="fk_trades_counterparty"/>
        </rollback>
    </changeSet>

    <!-- Step 9: Migrate data from legacy table -->
    <changeSet id="004-migrate-trades-data" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
            <tableExists tableName="trades_legacy"/>
            <tableExists tableName="trades"/>
        </preConditions>
        <sql>
            INSERT INTO trades (id, trade_ref, instrument_id, counterparty_id, asset_class,
                               side, quantity, price, trade_date, status, deleted_at,
                               created_at, modified_at)
            SELECT id, trade_ref, instrument_id, counterparty_id, asset_class,
                   side, quantity, price, trade_date, status, deleted_at,
                   created_at, modified_at
            FROM trades_legacy;
        </sql>
        <rollback/>
    </changeSet>

    <!-- Step 10: Skip foreign key from settlements to partitioned trades.
         PostgreSQL partitioned tables cannot have FK references to just the id column
         since unique constraints must include all partition columns.
         Data integrity is maintained at the application level. -->

    <!-- Step 11: Drop legacy table -->
    <changeSet id="004-drop-legacy-table" author="trainer">
        <preConditions onFail="MARK_RAN">
            <dbms type="postgresql"/>
            <tableExists tableName="trades_legacy"/>
        </preConditions>
        <dropTable tableName="trades_legacy"/>
        <rollback>
            <sql>SELECT 1;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
