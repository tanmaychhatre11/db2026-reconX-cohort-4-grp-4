{
  "annotations": { "list": [] }, "editable": true, "graphTooltip": 1, "id": null,
  "panels": [
    { "id": 1, "type": "timeseries", "title": "API request rate by endpoint (ADV087)",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [ { "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (uri)", "legendFormat": "{{uri}}" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 } },

    { "id": 2, "type": "timeseries", "title": "API response time P50/P95/P99 (ADV088)",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))", "legendFormat": "P50 {{uri}}" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))", "legendFormat": "P95 {{uri}}" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))", "legendFormat": "P99 {{uri}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 } },

    { "id": 3, "type": "stat", "title": "Open recon breaks (ADV091)",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [ { "expr": "recon_break_count" } ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }
        ] } } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 } },

    { "id": 4, "type": "timeseries", "title": "Trades created / sec (ADV089)",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [ { "expr": "sum(rate(trade_creation_total[1m]))", "legendFormat": "trades/sec" } ],
      "fieldConfig": { "defaults": { "unit": "trades/s" } },
      "gridPos": { "h": 4, "w": 12, "x": 6, "y": 8 } },

    { "id": 5, "type": "piechart", "title": "Trades by status (ADV092)",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [ { "expr": "trades_by_status", "legendFormat": "{{status}}" } ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }, "pieType": "pie",
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] } },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 8 } },

    { "id": 6, "type": "heatmap", "title": "Reconciliation duration histogram (ADV090)",
      "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
      "targets": [ { "expr": "sum(rate(reconciliation_duration_seconds_bucket[5m])) by (le)", "legendFormat": "{{le}}", "format": "heatmap" } ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 } },
    
      {
        "id": 8,
        "type": "timeseries",
        "title": "Throughput: produced vs consumed",
        "datasource": { "type": "prometheus", "uid": "reconx-prometheus" },
        "targets": [
          {
            "expr": "sum(rate(kafka_producer_record_send_total[1m]))",
            "legendFormat": "produced"
          },
          {
            "expr": "sum(rate(kafka_consumer_records_consumed_total[1m]))",
            "legendFormat": "consumed"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 }
      }
  ],
  "refresh": "10s", "schemaVersion": 39, "tags": ["reconx"], "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" }, "title": "ReconX Overview", "uid": "reconx-overview", "version": 1
}